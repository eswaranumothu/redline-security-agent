# REDLINE Environment Configuration Example
# Copy to .env and adjust variables as needed.

# Database Connection (Docker PostgreSQL container: redline_postgres)
DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/redline_db

# Security & JWT Authentication
SECRET_KEY=change_this_to_a_secure_secret_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Gemini AI / LLM Configuration
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-3.5-flash-lite

# Hindsight Persistent Security Memory Engine
HINDSIGHT_API_URL=http://localhost:8888
HINDSIGHT_API_KEY=your_optional_hindsight_api_key
HINDSIGHT_TIMEOUT_SECONDS=5.0
